{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "novastack",
	"compatibility_date": "2026-08-20",

	// `main` + `assets` is what tells adapter-cloudflare this is Workers static assets rather
	// than Pages. Without it the adapter assumes Pages and emits a `_routes.json` whose 100-rule
	// limit our 1,167 mirrored images blow straight through — which would have caused exactly the
	// unnecessary Worker invocations this project is shaped to avoid.
	"main": ".svelte-kit/cloudflare/_worker.js",

	// Committed here rather than left as a dashboard-only variable: Workers Builds treats this
	// file as authoritative and syncs plain vars to match it exactly on every deploy, so a
	// dashboard-set ORIGIN with no corresponding entry here gets silently wiped on the next
	// deploy — which is exactly what happened once, and crashed the Worker (src/env.ts requires
	// ORIGIN at real runtime). BETTER_AUTH_SECRET stays dashboard/CLI-only on purpose — it's a
	// secret, never belongs in a committed file, and isn't subject to this same sync-wipe.
	"vars": {
		"ORIGIN": "https://novastack.joshfullmer9.workers.dev"
	},

	// The deckbuilder's backend (accounts, decks, likes) — see docs/spec/deckbuilder.md §3.2.
	// Scoped deliberately: this binding is the only new backend surface the deckbuilder adds.
	// Bound as `DB` rather than wrangler's suggested `novastack_decks` — one generic name, since
	// there is and should stay only one database.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "novastack-decks",
			"database_id": "16985ed2-7e55-4552-a104-bd9475626249",
			// `drizzle-kit generate` writes here — one migrations folder, not two.
			"migrations_dir": "drizzle"
		}
	],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",

		// MUST be "none". This used to be "404-page" — harmless back when every real route had a
		// matching prerendered asset, so any miss really was a broken link. Now that /decks, /auth
		// etc. are legitimate dynamic routes with no static asset at all, "404-page" (or
		// "single-page-application") answers those navigation-shaped requests directly at the edge
		// — a styled-but-wrong 404 — without ever invoking the Worker. "none" is what lets an
		// asset-miss fall through to `main` so SvelteKit's own router (and its real `+error.svelte`)
		// gets to decide, which is required for any dynamic route to work at all.
		"not_found_handling": "none"

		// NEVER set `run_worker_first`. It routes asset requests through the Worker, which makes
		// them billable — and asset requests are the only traffic this site has at volume
		// (1,167 images). Static-asset requests are free and unlimited; the 100k/day free limit
		// applies solely to requests that invoke the Worker script.
		//
		// For the same reason, never route assets through the Workers Caching API: those are
		// billed at the Worker rate.
	},

	// Workers Logs. Note the shape: the top-level `enabled` is false while `logs.enabled` is true —
	// that is what the dashboard emits for "logs on, traces off", and the nested flag wins for logs.
	//
	// Worth knowing what this will and will not show. The card database still prerenders in full,
	// so its traffic never reaches the Worker — only the deckbuilder routes (`/decks/*`, D1-backed)
	// and the 404 fallback invoke it. A card-database visit showing up here would mean something is
	// routing asset requests through the Worker — `run_worker_first`, or assets failing to match —
	// and those requests are billable, unlike the static-asset hits they should have been.
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
